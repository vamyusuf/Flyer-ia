{
  "version": 2,
  "builds": [
    {
      "src": "flyer-ia/backend/app.py",  
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "python3.11"
      }
    },
    {
      "src": "flyer-ia/package.json",    
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "flyer-ia/backend/app.py" 
    }
    ]
}
